  <appSettings>
    <add key="Email.WriteAsFile" value="false" />
    <add key="Email.ServerName" value="scan2mail.wagner-group.eu" />
    <add key="Email.UserName" value="novaalerts@wagner-group.com" />
    <add key="Email.Password" value="Letmeknownow!" />
    <add key="Email.MailToAddress" value="jktieman@gmail.com" />
    <add key="Email.MailFromAddress" value="novaalerts@wagner-group.com" />
    <add key="Email.MailCc" value="" />
    <add key="Email.UseSsl" value="false" />
    <add key="Email.UseCredentials" value="false" />
    <add key="Email.ServerPort" value="25" />
    <add key="Email.DefaultReplyToAddress" value="novaalerts@wagner-group.com" />
    <add key="Email.FileLocation" value="C:\SapConsole\Email" />
