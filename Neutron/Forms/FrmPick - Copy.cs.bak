        private void MBPickAccept_Click(object sender, EventArgs e)
        {
            if (PickComplete(int.Parse(LabelPickQty.Text)))
            {
                if (bindingSourceViewPick.Position + 1 < bindingSourceViewPick.Count)
                {
                    bindingSourceViewPick.MoveNext();
                    currentPickView = (PickView) bindingSourceViewPick.Current;
                    PositionDevice(currentPickView.CurrentInventoryLocation.Location);
                    TextBoxPickedSoFar.Text = string.Empty;
                    currentPickView.PickedQty = 0;
                    LabelPickQty.Text = string.Empty;
                    pickedSoFar = 0;
                    UpdatePickScreen();
                }
                else
                {
                    CloseBatch();
                }
            }

            UpdatePickScreen();
        }

        private bool PickComplete(int v)
        {
            pickedSoFar += v;
            if (pickedSoFar == currentPickView.Quantity)
            {
                UpdateInventoryQuantity(LabelPickQty.Text);
                return true;
            }
            else if (pickedSoFar > currentPickView.Quantity)
            {
                DialogResult result = MessageBox.Show("Do you want to overpick this item?", "Overpick Question"
                    , MessageBoxButtons.YesNoCancel, MessageBoxIcon.Question);
                if (result == DialogResult.Yes)
                {
                    UpdateInventoryQuantity(LabelPickQty.Text);
                    return true;
                }
                return false;
            }
            else if (pickedSoFar < currentPickView.Quantity)
            {
                DialogResult result = MessageBox.Show("Do you want to short pick this item?", "Short Pick Question"
                   , MessageBoxButtons.YesNoCancel, MessageBoxIcon.Question);
                if (result == DialogResult.Yes)
                {
                    UpdateInventoryQuantity(LabelPickQty.Text);
                    return true;
                }
                else
                {
                    MessageBox.Show("Do not Pick Short.  What do you want to do?");
                    UpdateInventoryQuantity(LabelPickQty.Text);
                    if (GetNextInventoryLocation()) //there is another location
                    {
                        MessageBox.Show("No more locations");
                    }
                    //go to next inventory location if there is one?
                    //tell them there is no more inventory, finish short or put order on hold to pick later.
                    return false;
                }

            }

            return false;
        }

        private void UpdateInventoryQuantity(string text)
        {
            int qty = int.Parse(text);
            currentPickView.CurrentInventoryLocation.Quantity -= qty;
            repoInventory.Update(currentPickView.CurrentInventoryLocation);

        }

        private void CloseBatch()
        {
            pickedSoFar = 0;
            ClearOrderPositions();
            // write results to history
            // wirte results to upload
            MarkCompleted(ordersToPick);
            tabControl1.SelectedTab = AvailableOrders;

        }



        private void MarkCompleted(List<BatchPosition> ordersToPick)
        {
            foreach (BatchPosition ord in ordersToPick)
            {
                if (ord.OrderId != null)
                {
                    int id = ord.OrderId.Value;
                    Order rec = repoOrders.FindByKey(id);
                    rec.OrderStatusId = 6;
                    repoOrders.Update(rec);
                    ShowListing();
                }
            }
        }

        private void ButtonPreviousInventoryLocation_Click(object sender, EventArgs e)
        {
            GetPreviousInventoryLocation();
        }

        private void GetPreviousInventoryLocation()
        {
            if (currentPickView.InventoryIndex - 1 < 0)
            {
                currentPickView.InventoryIndex = 0;
            }
            else
            {
                currentPickView.InventoryIndex -= 1;
            }
            currentPickView.CurrentInventoryLocation = currentPickView.Inventory[currentPickView.InventoryIndex];
            UpdateInventoryLocation();
        }


        private void ButtonNextInventoryLocation_Click(object sender, EventArgs e)
        {
            bool result = GetNextInventoryLocation();
        }

        private bool GetNextInventoryLocation()
        {
            bool result = false;
            if (currentPickView.InventoryIndex + 1 < currentPickView.Inventory.Count)
            {
                currentPickView.InventoryIndex += 1;
                currentPickView.CurrentInventoryLocation = currentPickView.Inventory[currentPickView.InventoryIndex];
                UpdateInventoryLocation();
                result = true;
            }
            currentPickView.CurrentInventoryLocation = currentPickView.Inventory[currentPickView.InventoryIndex];
            UpdateInventoryLocation();
            return result;
        }


