        private void ButtonSaveNewRole_Click(object sender, EventArgs e)
        {
            if (TextBoxNewRole.Text.Length > 3)
            {
                context.Roles.Add(new Role { RoleName = TextBoxNewRole.Text });
                context.SaveChanges();
                LoadRoles();
            }
        }

