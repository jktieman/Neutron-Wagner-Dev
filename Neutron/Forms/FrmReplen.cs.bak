        private void GetLastStop(bool moveDevice = true)
        {
            int numberOfStops = bindingSourcePickStops.Count;
            if (numberOfStops > 0)
            {
                bindingSourcePickStops.MoveLast();
                currentPickStop = (PickStop) bindingSourcePickStops.Current;
                UpdatePickScreen();
