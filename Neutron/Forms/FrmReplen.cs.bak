        private void PrintAllDocuments()
        {
            foreach (BatchPosition bp in ordersToPick)
            {
                if (bp.OrderId != null)
                {
                    int id = bp.OrderId.Value;
                    Order order = repoOrders.FindByKey(id);
                    PrintJob printJob = repoPrintJob.FindBy(r => r.OrderId == order.Id && r.PickDocument == true).FirstOrDefault();
                    if (printJob == null)
                    {
                        PrintDoc(bp.PositionNumber, order);
                        printJob = new PrintJob { JobNum = order.Ord1, OrderId = order.Id, PickDocument = true };
                        repoPrintJob.Insert(printJob);
                    }

                }
            }
        }

        private void PrintDocument(int batchPosition)
        {
            foreach (BatchPosition bp in ordersToPick)
            {
                if (bp.PositionNumber == batchPosition)
                {
                    int id = bp.OrderId.Value;
                    Order order = repoOrders.FindByKey(id);
                    PrintJob printJob = repoPrintJob.FindBy(r => r.OrderId == order.Id && r.PickDocument == true).FirstOrDefault();
                    if (printJob == null)
                    {
                        PrintDoc(bp.PositionNumber, order);
                        printJob = new PrintJob { JobNum = order.Ord1, OrderId = order.Id, PickDocument = true };
                        repoPrintJob.Insert(printJob);
                    }
                }
            }
        }

        private void PrintDoc(int positionNumber, Order order)
        {
            // Task.Run(() => logger.Log($"Printing Document. {order.Ord1}"));
            if (neutronVariables.EnableDocumentPrinter)
            {
                Task.Run(() => DocumentToPrint.Print(positionNumber, order.Ord1, documentPrinter, order.Ord2));
            }
        }

