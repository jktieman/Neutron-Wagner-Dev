                    if (Convert.ToBoolean(checkBoxCell.Value) == false)
                    {
                        int id = Convert.ToInt32(row.Cells["Id"].Value);
                        string orderNumber = Convert.ToString(row.Cells["Ord1"].Value);
                        int idx = AddItemToBatch(id, orderNumber);
                        if (idx == -1)
                        {
                            //no more locations
                            break;
                        }
                        else
                        {
                            row.Cells[0].Value = checkBoxCell.TrueValue;
                        }
                    }
                }
            }
        }

