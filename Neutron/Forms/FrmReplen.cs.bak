        private int GetHotActionCode()
        {
            int result = 3;
            var radioButtons = new List<RadioButton> { RadioButtonPick, RadioButtonWarranty, RadioButtonScrap, RadioButtonOther };

            if (RadioButtonPick.Text == "Pick")
            {
                foreach (RadioButton item in radioButtons)
                {
                    if (item.Checked)
                    {
                        switch (item.Text)
                        {
                            case "Pick":
                                result = 3;
                                break;
                            case "Warranty":
                                result = 39;
                                break;
                            case "Scrap":
                                result = 40;
                                break;
                            case "Other":
                                result = 41;
                                break;
                            default:
                                result = 3;
                                break;
                        }
                    }
                }
            }
            else if (RadioButtonPick.Text == "Store")
            {
                foreach (RadioButton item in radioButtons)
                {
                    if (item.Checked)
                    {
                        switch (item.Text)
                        {
                            case "Store":
                                result = 4;
                                break;
                            case "Warranty":
                                result = 42;
                                break;
                            case "Scrap":
                                result = 43;
                                break;
                            case "Other":
                                result = 44;
                                break;
                            default:
                                result = 4;
                                break;
                        }
                    }
                }
            }

            return result;
        }

