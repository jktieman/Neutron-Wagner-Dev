

CREATE PROCEDURE[dbo].[usp_GetLocationViewsByStationAndSlot]
@StationId int,
@Slot varchar(50)
AS
BEGIN

SET NOCOUNT ON;
SELECT dbo.Locations.Id, dbo.Locations.StationId, dbo.Stations.Name AS StationName, dbo.Locations.Loc1
, dbo.Locations.Loc2, dbo.Locations.Loc3, dbo.Locations.Loc4, dbo.Locations.Loc5, dbo.Locations.Slot
, dbo.Locations.InUse, dbo.Locations.SizeCodeId, dbo.Locations.VelocityCodeId, dbo.Locations.HeightCodeId
, dbo.Locations.LocationCodeId, dbo.SizeCodes.Name AS SizeCodeName, '' as DeviceName
, dbo.VelocityCodes.Name AS VelocityCodeName, dbo.HeightCodes.Name AS HeightCodeName, dbo.LocationCodes.Name AS LocationCodeName
FROM   dbo.HeightCodes INNER JOIN
dbo.Locations ON dbo.HeightCodes.Id = dbo.Locations.HeightCodeId INNER JOIN
dbo.SizeCodes ON dbo.Locations.SizeCodeId = dbo.SizeCodes.Id INNER JOIN
dbo.Stations ON dbo.Locations.StationId = dbo.Stations.Id INNER JOIN
dbo.VelocityCodes ON dbo.Locations.VelocityCodeId = dbo.VelocityCodes.Id INNER JOIN
dbo.LocationCodes ON dbo.Locations.LocationCodeId = dbo.LocationCodes.Id
WHERE ((LOWER(dbo.Locations.Slot) LIKE '%' + @Slot + '%') 
AND dbo.Locations.StationId = @StationId )

ORDER BY dbo.Locations.Slot
END